{
  "name": "temple-arena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/dev-server.js",
    "test": "node --test tests/*.test.js",
    "test:api": "node tests/api-smoke.mjs",
    "test:browser": "node tests/browser.mjs",
    "build:cloud": "node cloudflare/build.mjs",
    "dev:cloud": "npm run build:cloud && wrangler dev --local --port 8787",
    "deploy:cloud": "npm run build:cloud && wrangler deploy",
    "check": "node --check src/main.js && node --check src/shared/temple-rules.js && node --check cloudflare/worker.js"
  },
  "dependencies": {
    "three": "^0.160.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "playwright": "1.59.1",
    "wrangler": "^4.149.0"
  }
}
